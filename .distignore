# Files and directories listed here are excluded from the wp.org SVN deploy
# (10up/action-wordpress-plugin-deploy reads this file, gitignore-style format).
# They live in the GitHub repo but never reach the published plugin.

# Repo metadata
.git
.github
.gitignore
.gitattributes
.distignore
.editorconfig

# wp.org listing assets — handled separately by the deploy action (uploaded to
# SVN /assets/, not /trunk/). Excluding it here prevents duplication in /trunk/.
.wordpress-org

# Documentation (GitHub-only)
README.md
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md
AGENTS.md
CLAUDE.md
docs

# Dev dependencies
node_modules
vendor
package.json
package-lock.json
composer.json
composer.lock

# Dev environment
.wp-env.json
.wp-env.override.json

# Linters / static analysis configuration and caches
phpcs.xml
phpcs.xml.dist
.phpcs-cache
phpstan.neon
phpstan.neon.dist
phpstan-baseline.neon
phpstan-bootstrap.php
.phpstan
psalm.xml
psalm.xml.dist
psalm-baseline.xml
.psalm

# End-to-end runner (browser tests; never part of what ships)
playwright*.config.ts
playwright-report
test-results

# Tests and test artifacts
phpunit.xml
phpunit.xml.dist
phpunit-integration.xml
phpunit-load.xml
phpunit-integration.xml.dist
tests
.phpunit.result.cache
.phpunit.cache
.phpunit-integration.result.cache
coverage
coverage.xml
clover.xml

# Build / dev tooling
Makefile
tools
bin
scripts

# IDE and AI tooling
.idea
.vscode
.claude
.cursor

# Bundled translations are never loaded from the plugin folder: without
# load_plugin_textdomain() (discouraged for directory-hosted plugins) WordPress
# reads plugin translations from wp-content/languages/plugins/, where
# translate.wordpress.org's language packs go. The .pot stays; the .po/.mo are
# the source for translate.wordpress.org, and `make deploy-test` puts the .mo
# where WordPress reads them on a test site.
languages/*.po
languages/*.mo

# Local secrets: never in a build, whatever their name
.env
.env.*

# Build artifacts and logs
build
*.zip
*.log
*.tar
*.tar.gz
